<Window x:Class="ClaudeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Launcher" Width="520" Height="620" MinWidth="400" MinHeight="380"
        WindowStartupLocation="CenterScreen" Icon="Assets/icon.ico" Background="{StaticResource Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{StaticResource Text}"
        Activated="OnActivated" SourceInitialized="OnSourceInitialized" Loaded="OnLoaded" Closed="OnClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBar" Background="{StaticResource Border}"
                                                    CornerRadius="4" Margin="2,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBar" Property="Background"
                                                            Value="{StaticResource Muted}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RowSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Pin to top (Ctrl+P)"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Width="28" Height="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectRow" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6,7,12,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Open Claude" Click="OnMenuOpenClick"/>
            <MenuItem Header="Open Claude in new window" Click="OnMenuNewWindowClick"/>
            <MenuItem Header="Pin / unpin" Click="OnMenuPinClick"/>
            <MenuItem Header="Show in Explorer" Click="OnMenuExplorerClick"/>
            <Separator Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Header="Remove from list" Click="OnMenuRemoveClick"
                      Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="4" Padding="10,0">
            <DockPanel Height="38">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Grid>
                    <TextBlock x:Name="SearchHint" Text="Search projects" Foreground="{StaticResource Muted}"
                               IsHitTestVisible="False" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="14"
                             Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                             VerticalAlignment="Center"
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>
                </Grid>
            </DockPanel>
        </Border>

        <ListBox x:Name="ProjectList" Grid.Row="1" Margin="-6,10,-6,12" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource ProjectRow}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" ContextMenu="{StaticResource RowMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource PinButton}" Click="OnPinClick" Margin="0,0,6,0">
                            <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="{StaticResource Icons}"
                                       FontSize="13" Foreground="{StaticResource Muted}" Opacity="0"/>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DisplayPath}" FontSize="12" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="PinGlyph" Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="PinGlyph" Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter TargetName="PinGlyph" Property="Text" Value="&#xE842;"/>
                            <Setter TargetName="PinGlyph" Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter TargetName="PinGlyph" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="UpdateBanner" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12"
                Background="{StaticResource Field}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="4" Padding="12,6,6,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="10,4"
                        Content="Restart now" Click="OnRestartToUpdateClick"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                    <Run x:Name="UpdateText" Foreground="{StaticResource Text}"/>
                    <Run Text=" Installs when you restart or close the app."/>
                </TextBlock>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="OnAddFolderClick"
                    ToolTip="Add any folder on this PC to the list">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Add folder"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="New window" Margin="0,0,8,0"
                        ToolTip="Open in a new terminal window (Ctrl+Enter)" Click="OnNewWindowClick"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Open Claude"
                        ToolTip="Open as a new tab (Enter)" Click="OnOpenClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
